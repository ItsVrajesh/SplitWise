{
  "expo": {
    "name": "Orbit Split",
    "slug": "orbit-split",
    "scheme": "orbitsplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101715",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vrajesh.orbitsplit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101715",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vrajesh.orbitsplit"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6b6094f8-dba9-4c47-bdc8-d7096a504420"
      }
    }
  }
}
